  {
    "id": "parsevin",
    "type": "function",
    "z": "cp6flow01",
    "name": "Interpretar sensores + timestamp",
    "func": "// Recebe: t|24.00|u|40.00|l|1001\nconst partes = String(msg.payload).split('|');\nif (partes.length !== 6 || partes[0] !== 't' || partes[2] !== 'u' || partes[4] !== 'l') {\n    node.warn('Mensagem descartada: formato inesperado');\n    return null;\n}\nconst temperatura = Number(partes[1]);\nconst umidade = Number(partes[3]);\nconst luminosidade = Number(partes[5]);\nif (![temperatura, umidade, luminosidade].every(Number.isFinite)) {\n    node.warn('Mensagem descartada: valor nao numerico');\n    return null;\n}\nmsg.payload = {\n    temperatura,\n    umidade,\n    luminosidade,\n    timestamp: new Date().toISOString() // Horario de recebimento no Node-RED\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 180,
    "wires": [
      [
        "debugvin",
        "change_t",
        "change_u",
        "change_l",
        "make_csv"
      ]
    ]
  },

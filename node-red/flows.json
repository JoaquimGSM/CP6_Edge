  {
    "id": "make_csv",
    "type": "function",
    "z": "cp6flow01",
    "name": "Preparar histórico CSV",
    "func": "// Persiste cada leitura recebida em CSV separado por ponto-e-virgula.\n// O caminho e relativo ao perfil de usuario que inicia o Node-RED.\nconst d = msg.payload;\nconst pasta = env.get('USERPROFILE') || env.get('HOME') || '.';\nmsg.filename = pasta + '/vinheria_agnello_historico.csv';\nmsg.payload = `${d.timestamp};${d.temperatura};${d.umidade};${d.luminosidade}`;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 730,
    "y": 610,
    "wires": [
      [
        "append_csv"
      ]
    ]
  },
